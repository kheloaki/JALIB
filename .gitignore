# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# cursor
.cursor/
.mcp.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Stitch dev export (regenerate with scripts/fetch-stitch-screen.mjs)
/.stitch-export/

# Jamaa Excel dumps — keep outside the Next root (symlinks break Turbopack)
/Clients  JAMAA
/DATA CLIENTS
/DATA CLIENTS/**
/DATA PRODUCTS JAMAA

# Local product image-search exports
/exports/
